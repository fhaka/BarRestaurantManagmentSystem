{
  "name": "tavolina",
  "private": true,
  "version": "0.1.0",
  "description": "Tavolina — restaurant & café management system",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,staff,guest -c yellow,cyan,magenta \"npm:dev -w @tavolina/api\" \"npm:dev -w @tavolina/staff\" \"npm:dev -w @tavolina/guest\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:all": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:e2e",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "npm run db:migrate -w @tavolina/api",
    "db:rollback": "npm run db:rollback -w @tavolina/api",
    "db:seed": "npm run db:seed -w @tavolina/api",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "node node_modules/eslint/bin/eslint.js --fix",
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}

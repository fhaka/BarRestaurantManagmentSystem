# Production settings for docker-compose.prod.yml. Copy to .env.production and fill in.
# Never commit the real file.

MYSQL_DATABASE=tavolina
MYSQL_USER=tavolina
MYSQL_PASSWORD=change-me-long-random-password
MYSQL_ROOT_PASSWORD=change-me-another-long-random-password

# At least 32 characters: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-openssl-rand-hex-32-output-here

# The public HTTPS addresses of the staff app and the guest app (the API only accepts these).
CORS_ORIGINS=https://staff.example.al,https://menu.example.al
# Printed into table QR codes and the booking link.
GUEST_APP_URL=https://menu.example.al

# Host ports nginx listens on (put HTTPS in front of them).
STAFF_PUBLIC_PORT=8080
GUEST_PUBLIC_PORT=8081

# true loads the "Bar Restaurant Las Vegas" demo when the database is still empty (never wipes data).
SEED_DEMO=false
LOG_LEVEL=info

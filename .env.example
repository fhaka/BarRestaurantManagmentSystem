# Copy to .env and adjust. Never commit .env.
# Do not set NODE_ENV here: Vite reads this file too and would ship dev React builds.

# --- MySQL (docker compose reads these too) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_DATABASE=tavolina
MYSQL_TEST_DATABASE=tavolina_test
MYSQL_USER=tavolina
MYSQL_PASSWORD=tavolina_dev_password
MYSQL_ROOT_PASSWORD=tavolina_root_dev_password

# --- API ---
API_PORT=4100
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5180,http://localhost:5181

# --- Frontends (Vite dev servers) ---
STAFF_PORT=5180
GUEST_PORT=5181

# --- Auth ---
# At least 32 characters. Generate a real one with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
BCRYPT_COST=12
